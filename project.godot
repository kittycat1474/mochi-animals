; Godot 4.7 project. Open this file and press F6/F5.
config_version=5

[application]
config/name="Mochi Animals"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon.svg"

[display]
window/size/viewport_width=540
window/size/viewport_height=960
window/size/window_width_override=486
window/size/window_height_override=864
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.985, 0.965, 0.932, 1)
anti_aliasing/quality/msaa_2d=0

[physics]
common/physics_ticks_per_second=60

[audio]
driver/enable_input=false
